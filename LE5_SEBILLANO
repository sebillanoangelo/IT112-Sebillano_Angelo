#include <stdio.h>

int main() {
    int number;
    int total = 0;

    printf("Enter a positive number to ADD (zero or negative to stop): ");
    scanf("%d", &number);

    while (number > 0) {
        total += number;

        printf("Enter another number: ");
        scanf("%d", &number);
    }

    printf("Total sum is: %d", total);

    return 0;
}
